{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SIkebe/ghpmv/tests/e2e.settings.schema.json",
  "title": "ghpmv E2E settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "target", "fixtures", "users", "gei", "execution"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "source": { "$ref": "#/$defs/endpoint" },
    "target": { "$ref": "#/$defs/endpoint" },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration", "browser"],
      "properties": {
        "integration": { "$ref": "#/$defs/fixture" },
        "browser": { "$ref": "#/$defs/fixture" }
      }
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBrowserLogin", "targetBrowserLogin", "collaboratorLogin", "mappings"],
      "properties": {
        "sourceBrowserLogin": { "type": "string" },
        "targetBrowserLogin": { "type": "string" },
        "collaboratorLogin": { "type": "string", "minLength": 1 },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceLogin", "targetLogin"],
            "properties": {
              "sourceLogin": { "type": "string", "minLength": 1 },
              "targetLogin": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "gei": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRepository",
        "targetRepository",
        "targetRepositoryVisibility",
        "sourceTokenEnvironmentVariable",
        "targetTokenEnvironmentVariable",
        "sourceTokenOwnerLogin",
        "targetTokenOwnerLogin",
        "sourceRole",
        "targetRole"
      ],
      "properties": {
        "sourceRepository": { "type": "string", "minLength": 1 },
        "targetRepository": { "type": "string", "minLength": 1 },
        "targetRepositoryVisibility": { "enum": ["private", "internal", "public"] },
        "sourceTokenEnvironmentVariable": {
          "$ref": "#/$defs/environmentVariable",
          "description": "Must differ from targetTokenEnvironmentVariable for cross-deployment GEI."
        },
        "targetTokenEnvironmentVariable": {
          "$ref": "#/$defs/environmentVariable",
          "description": "Must differ from sourceTokenEnvironmentVariable for cross-deployment GEI."
        },
        "sourceTokenOwnerLogin": { "type": "string" },
        "targetTokenOwnerLogin": { "type": "string" },
        "sourceRole": { "$ref": "#/$defs/geiRole" },
        "targetRole": { "$ref": "#/$defs/geiRole" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixturePreparation",
        "repositoryPreparationMode",
        "reuseSourceFixture",
        "createTemporaryTargetProject"
      ],
      "properties": {
        "fixturePreparation": { "enum": ["existing", "create"] },
        "repositoryPreparationMode": { "enum": ["gei", "fixture-seed"] },
        "reuseSourceFixture": { "type": "boolean" },
        "createTemporaryTargetProject": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "repositoryPreparationMode": { "const": "gei" }
            },
            "required": ["repositoryPreparationMode"]
          },
          "target": {
            "properties": {
              "apiBaseUrl": { "pattern": "^https://api\\.[A-Za-z0-9-]+\\.ghe\\.com" }
            },
            "required": ["apiBaseUrl"]
          }
        },
        "required": ["execution", "target"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "uploadsBaseUrl": {
                "type": "string",
                "pattern": "^https://uploads\\.[A-Za-z0-9-]+\\.ghe\\.com/?$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "apiBaseUrl",
        "webBaseUrl",
        "uploadsBaseUrl",
        "browserProfile",
        "browserStateEnvironmentVariable",
        "tokenEnvironmentVariable"
      ],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "apiBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://api(?:\\.github\\.com|\\.[A-Za-z0-9-]+\\.ghe\\.com)(?:/graphql)?/?$"
        },
        "webBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:github\\.com|[A-Za-z0-9-]+\\.ghe\\.com)/?$"
        },
        "uploadsBaseUrl": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://uploads(?:\\.github\\.com|\\.[A-Za-z0-9-]+\\.ghe\\.com)/?$"
            }
          ]
        },
        "browserProfile": { "type": "string", "minLength": 1 },
        "browserStateEnvironmentVariable": {
          "$ref": "#/$defs/environmentVariable",
          "description": "Must not match either endpoint's tokenEnvironmentVariable."
        },
        "tokenEnvironmentVariable": {
          "$ref": "#/$defs/environmentVariable",
          "description": "Must not match either endpoint's browserStateEnvironmentVariable."
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectNumber", "sourceRepository", "targetRepository"],
      "properties": {
        "projectNumber": { "type": "integer", "minimum": 1 },
        "sourceRepository": { "type": "string", "minLength": 1 },
        "targetRepository": { "type": "string", "minLength": 1 }
      }
    },
    "environmentVariable": {
      "type": "string",
      "pattern": "^(?!(?:ghp|gho|ghu|ghs|ghr|github_pat)_)[A-Za-z_][A-Za-z0-9_]*$"
    },
    "geiRole": {
      "enum": ["owner", "migrator-active", "migrator-pending"]
    }
  }
}
